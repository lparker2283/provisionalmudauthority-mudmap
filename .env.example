# Supabase project settings -> API. Server-side only; never prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The one password for /admin. Use something long.
ADMIN_PASSWORD=change-me-to-something-long

# Optional: phone push notifications via ntfy (https://ntfy.sh). A long,
# unguessable topic name; subscribe to it in the ntfy app. Leave unset to
# turn notifications off.
NTFY_TOPIC=
# Optional: only if you self-host ntfy or use a free ntfy account token.
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=
